<?php

namespace App\Services;

use Illuminate\Support\Str;

class InformacaoInstitucionalService
{
    public function pesquisar(string $pergunta, string $idioma = 'pt'): ?array
    {
        $texto = app(InterpretadorPerguntasService::class)
            ->corrigir($pergunta);
        $liceus = config('assistente_eiffel.liceus', []);

        $localizacao = $this->contem($texto, [
            'onde fica', 'onde esta', 'onde se localiza',
            'localizacao', 'localizado', 'morada', 'endereco',
            'where is', 'where are', 'where can i find',
            'location', 'located', 'address',
            'ou se trouve', 'ou sont', 'localisation',
            'adresse', 'situe'
        ]);

        $contacto = $this->contem($texto, [
            'contacto', 'contactar', 'telefone', 'telemovel',
            'email', 'correio eletronico',
            'contact', 'phone', 'telephone', 'call',
            'reach', 'contacter', 'joindre'
        ]) || $this->contem($texto, [
            'falar com a rede eiffel',
            'falar com o liceu',
            'falar com a secretaria',
            'falar com a coordenacao',
            'ligar para a rede eiffel',
            'ligar para o liceu',
            'ligar para a secretaria',
            'numero da secretaria',
            'numero do liceu',
            'entrar em contacto',
            'get in touch',
            'speak to the school',
            'parler au secretariat'
        ]);

        $inscricao = $this->contem($texto, [
            'inscricao', 'inscricoes', 'inscrever', 'matricula',
            'admissao', 'candidatura',
            'registration', 'register', 'enrollment', 'admission',
            'inscription', 'inscrire', 'admissions'
        ]);

        $lista = $this->contem($texto, [
            'quais sao os liceus', 'lista de liceus',
            'quantos liceus', 'liceus da rede',
            'which schools', 'list of schools',
            'how many schools', 'schools of rede eiffel',
            'quels sont les lycees', 'liste des lycees',
            'combien de lycees'
        ]);

        $liceu = $this->identificarLiceu($texto, $liceus);

        if ($contacto && $liceu !== null) {
            $telefones = implode(' / ', $liceu['telefones']);
            $nome = $liceu['nome'];

            return $this->responder([
                'pt' => "Contactos da secretaria do {$nome}: {$telefones}.",
                'en' => "Secretariat contact numbers for {$nome}: {$telefones}.",
                'fr' => "Numéros du secrétariat du {$nome} : {$telefones}.",
            ], $idioma, 'Contactos das secretarias', route('inscricoes'));
        }

        if ($localizacao && $liceu !== null) {
            $nome = $liceu['nome'];
            $local = $liceu['localizacao'];

            return $this->responder([
                'pt' => "O {$nome} está localizado em {$local}.",
                'en' => "{$nome} is located in {$local}.",
                'fr' => "Le {$nome} se trouve à {$local}.",
            ], $idioma, 'Localização dos liceus', route('apresentacao_liceu'));
        }

        if ($inscricao) {
            $dados = config('assistente_eiffel.inscricoes', []);
            $email = $dados['email'] ?? '';

            return $this->responder([
                'pt' => "As inscrições encontram-se temporariamente indisponíveis. Aguarde a publicação oficial das datas. Para informações: {$email}.",
                'en' => "Registrations are temporarily unavailable. Please wait for the official announcement of registration dates. For information: {$email}.",
                'fr' => "Les inscriptions sont temporairement indisponibles. Veuillez attendre l'annonce officielle des dates d'inscription. Pour plus d'informations : {$email}.",
            ], $idioma, 'Inscrições', route('inscricoes'));
        }

        if ($lista) {
            $nomes = [];

            foreach ($liceus as $item) {
                $nomes[] = $item['nome'] . ' — ' . $item['localizacao'];
            }

            $conteudo = implode("\n", $nomes);

            return $this->responder([
                'pt' => "Os liceus da Rede Eiffel são:\n{$conteudo}",
                'en' => "The Rede Eiffel schools are:\n{$conteudo}",
                'fr' => "Les lycées du Réseau Eiffel sont :\n{$conteudo}",
            ], $idioma, 'Liceus da Rede Eiffel', route('apresentacao_liceu'));
        }

        if ($contacto) {
            $dados = config('assistente_eiffel.contactos.atendimento', []);

            $email = $dados['email'] ?? '';
            $telefone = $dados['telefone'] ?? '';
            $local = $dados['localizacao'] ?? '';

            return $this->responder([
                'pt' => "Contactos publicados na página Fale connosco:\nEmail: {$email}\nTelefone: {$telefone}\nLocalização: {$local}.",
                'en' => "Contacts published on the Contact Us page:\nEmail: {$email}\nPhone: {$telefone}\nLocation: {$local}.",
                'fr' => "Coordonnées publiées sur la page Contactez-nous :\nEmail : {$email}\nTéléphone : {$telefone}\nAdresse : {$local}.",
            ], $idioma, 'Fale connosco', route('fale_conosco'));
        }

        if ($localizacao) {
            $dados = config('assistente_eiffel.contactos.atendimento', []);
            $local = $dados['localizacao'] ?? '';

            return $this->responder([
                'pt' => "A página Fale connosco apresenta a localização: {$local}.",
                'en' => "The Contact Us page lists this location: {$local}.",
                'fr' => "La page Contactez-nous indique cette localisation : {$local}.",
            ], $idioma, 'Fale connosco', route('fale_conosco'));
        }

        return null;
    }

    private function identificarLiceu(string $texto, array $liceus): ?array
    {
        foreach ($liceus as $liceu) {
            $aliases = array_merge(
                $liceu['aliases'] ?? [],
                [$liceu['codigo'] ?? '', $liceu['nome'] ?? '']
            );

            foreach ($aliases as $alias) {
                $alias = $this->normalizar($alias);

                if ($alias === '') {
                    continue;
                }

                if (preg_match(
                    '/(?<![\pL\pN])' . preg_quote($alias, '/') . '(?![\pL\pN])/u',
                    $texto
                )) {
                    return $liceu;
                }
            }
        }

        return null;
    }

    private function responder(
        array $mensagens,
        string $idioma,
        string $titulo,
        string $url
    ): array {
        return [
            'encontrado' => true,
            'resposta' => $mensagens[$idioma] ?? $mensagens['pt'],
            'fontes' => [
                [
                    'titulo' => $titulo,
                    'url' => $url,
                ],
            ],
        ];
    }

    private function contem(string $texto, array $termos): bool
    {
        foreach ($termos as $termo) {
            if (str_contains($texto, $this->normalizar($termo))) {
                return true;
            }
        }

        return false;
    }

    private function normalizar(string $texto): string
    {
        return trim(
            preg_replace('/\s+/u', ' ', Str::ascii(mb_strtolower($texto)))
        );
    }
}