<?php

namespace App\Services;

use App\Models\Liceu;
use Illuminate\Support\Str;

class BuscaConteudoService
{
    public function pesquisar(string $pergunta, string $idioma = 'pt'): array
    {
        $naoEncontrado = [
            'encontrado' => false,
            'resposta' => $this->mensagemIndisponivel($idioma),
            'fontes' => [],
        ];

        $texto = $this->normalizar($pergunta);

        $termosEquipa = [
            'director', 'diretor', 'direccao', 'direcao',
            'coordenador', 'coordenacao', 'responsavel',
            'equipa', 'equipe', 'director general',
            'directeur', 'direction', 'headmaster',
            'principal', 'management', 'team',
        ];

        if (! $this->contemAlgum($texto, $termosEquipa)) {
            return $naoEncontrado;
        }

        $liceus = Liceu::query()
            ->where('ativo', true)
            ->with(['membros' => function ($query) {
                $query->where('ativo', true)
                    ->orderBy('ordem')
                    ->orderBy('id');
            }])
            ->get();

        $liceuEncontrado = null;

        foreach ($liceus as $liceu) {
            $nome = $this->normalizar($liceu->nome);

            if (str_contains($texto, $nome)) {
                $liceuEncontrado = $liceu;
                break;
            }

            $codigo = $liceu->codigo
                ? $this->normalizar($liceu->codigo)
                : null;

            if ($codigo && preg_match(
                '/(?<![\pL\pN])' . preg_quote($codigo, '/') . '(?![\pL\pN])/u',
                $texto
            )) {
                $liceuEncontrado = $liceu;
                break;
            }

            $palavras = preg_split('/\s+/u', $nome);

            foreach ($palavras as $palavra) {
                if (
                    mb_strlen($palavra) >= 5 &&
                    ! in_array($palavra, ['liceu', 'eiffel', 'rede', 'coordenacao'], true) &&
                    preg_match(
                        '/(?<![\pL\pN])' . preg_quote($palavra, '/') . '(?![\pL\pN])/u',
                        $texto
                    )
                ) {
                    $liceuEncontrado = $liceu;
                    break 2;
                }
            }
        }

        if (! $liceuEncontrado) {
            return $naoEncontrado;
        }

        $cargoPretendido = null;

        if ($this->contemAlgum($texto, [
            'director geral', 'diretor geral',
            'director general', 'directeur general',
        ])) {
            $cargoPretendido = 'geral';
        } elseif ($this->contemAlgum($texto, [
            'director pedagogico', 'diretor pedagogico',
            'directeur pedagogique',
        ])) {
            $cargoPretendido = 'pedagogico';
        } elseif ($this->contemAlgum($texto, [
            'director administrativo', 'diretor administrativo',
            'directeur administratif',
        ])) {
            $cargoPretendido = 'administrativo';
        }

        // Não apresentar toda a equipa quando foi pedido um cargo específico
        // que ainda não está contemplado nas regras de identificação.
        $perguntaSobreDirector = $this->contemAlgum($texto, [
            'director', 'diretor', 'directeur',
        ]);

        if ($perguntaSobreDirector && $cargoPretendido === null) {
            return $naoEncontrado;
        }

        $membros = $liceuEncontrado->membros;

        if ($cargoPretendido !== null) {
            $membros = $membros->filter(function ($membro) use ($cargoPretendido) {
                $cargo = $this->normalizar($membro->cargo);

                return (
                    $this->contemAlgum($cargo, ['director', 'diretor', 'directeur']) &&
                    str_contains($cargo, $cargoPretendido)
                );
            });
        }

        if ($membros->isEmpty()) {
            return $naoEncontrado;
        }

        $linhas = $membros->map(function ($membro) {
            return "{$membro->cargo}: {$membro->nome}";
        })->values()->all();

        return [
            'encontrado' => true,
            'resposta' => implode("\n", $linhas),
            'fontes' => [
                [
                    'titulo' => 'Equipa da Rede Eiffel',
                    'url' => route('equipe'),
                ],
            ],
        ];
    }

    private function normalizar(string $texto): string
    {
        return trim(
            preg_replace(
                '/\s+/u',
                ' ',
                Str::ascii(mb_strtolower($texto))
            )
        );
    }

    private function contemAlgum(string $texto, array $termos): bool
    {
        foreach ($termos as $termo) {
            if (str_contains($texto, $this->normalizar($termo))) {
                return true;
            }
        }

        return false;
    }

    private function mensagemIndisponivel(string $idioma): string
    {
        return match ($idioma) {
            'en' => 'This information has not yet been made available on the Rede Eiffel website.',
            'fr' => "Cette information n'a pas encore été publiée sur le site du Réseau Eiffel.",
            default => 'Essa informação ainda não foi disponibilizada no site da Rede Eiffel.',
        };
    }
}