<?php

namespace App\Services;

use App\Models\Comentario;
use App\Models\Documento;
use App\Models\Galeria;
use App\Models\Slider;
use Illuminate\Support\Facades\Storage;
use Illuminate\Support\Str;

class PesquisaConteudosPublicosService
{
    public function pesquisar(string $pergunta, string $idioma = 'pt'): ?array
    {
        $texto = $this->normalizar($pergunta);

        $categoria = $this->identificarCategoria($texto);

        if ($categoria === null) {
            return null;
        }

        $termos = $this->extrairTermos($texto);

        $resultados = match ($categoria) {
            'documentos' => $this->pesquisarDocumentos($termos),
            'galerias' => $this->pesquisarGalerias($termos),
            'comentarios' => $this->pesquisarComentarios($termos),
            'sliders' => $this->pesquisarSliders($termos),
        };

        if (empty($resultados)) {
            return [
                'encontrado' => false,
                'resposta' => match ($idioma) {
                    'en' => 'No matching public content was found.',
                    'fr' => 'Aucun contenu public correspondant n’a été trouvé.',
                    default => 'Não foram encontrados conteúdos públicos relacionados com a sua pergunta.',
                },
                'fontes' => [],
            ];
        }

        usort($resultados, fn ($a, $b) => $b['pontuacao'] <=> $a['pontuacao']);

        $resultados = array_slice($resultados, 0, 5);

        return [
            'encontrado' => true,
            'resposta' => match ($idioma) {
                'en' => "Content found on the Rede Eiffel website:\n",
                'fr' => "Contenus trouvés sur le site du Réseau Eiffel :\n",
                default => "Conteúdos encontrados no site da Rede Eiffel:\n",
            } . implode("\n", array_column($resultados, 'titulo')),
            'fontes' => array_map(
                fn ($item) => [
                    'titulo' => $item['titulo'],
                    'url' => $item['url'],
                ],
                $resultados
            ),
        ];
    }

    private function identificarCategoria(string $texto): ?string
    {
        $categorias = [
            'documentos' => [
                'documento', 'documentos', 'pdf', 'comunicado',
                'comunicados', 'calendario', 'calendarios',
                'document', 'documents', 'schedule', 'calendrier'
            ],
            'galerias' => [
                'foto', 'fotos', 'fotografia', 'fotografias',
                'imagem', 'imagens', 'galeria', 'galerias',
                'photo', 'photos', 'picture', 'pictures',
                'image', 'images', 'galerie'
            ],
            'comentarios' => [
                'comentario', 'comentarios', 'testemunho',
                'testemunhos', 'opinioes', 'opinion',
                'comments', 'comment', 'temoignage'
            ],
            'sliders' => [
                'slider', 'sliders', 'banner', 'banners',
                'destaques', 'diapositives'
            ],
        ];

        foreach ($categorias as $categoria => $palavras) {
            foreach ($palavras as $palavra) {
                if ($this->contemPalavra($texto, $palavra)) {
                    return $categoria;
                }
            }
        }

        return null;
    }

    private function pesquisarDocumentos(array $termos): array
    {
        $resultados = [];

        $documentos = Documento::where('ativo', true)->get();

        foreach ($documentos as $documento) {

            if (
                !$documento->ficheiro ||
                !Storage::disk('public')->exists($documento->ficheiro)
            ) {
                continue;
            }

            $conteudo = implode(' ', [
                $documento->titulo,
                $documento->categoria,
                $documento->descricao,
                $documento->ano_letivo,
            ]);

            $pontuacao = $this->pontuar($conteudo, $termos);

            if ($pontuacao === 0) {
                continue;
            }

            $resultados[] = [
                'titulo' => $documento->titulo,
                'url' => route('documentos.visualizar', $documento),
                'pontuacao' => $pontuacao,
            ];
        }

        return $resultados;
    }

    private function pesquisarGalerias(array $termos): array
    {
        $resultados = [];

        foreach (Galeria::all() as $galeria) {

            $pontuacao = $this->pontuar(
                $galeria->titulo . ' ' . $galeria->tipo,
                $termos
            );

            if ($pontuacao === 0) {
                continue;
            }

            $resultados[] = [
                'titulo' => $galeria->titulo ?: 'Fotografia da Rede Eiffel',
                'url' => route('galerias'),
                'pontuacao' => $pontuacao,
            ];
        }

        return $resultados;
    }

    private function pesquisarComentarios(array $termos): array
    {
        $resultados = [];

        foreach (Comentario::all() as $comentario) {

            $pontuacao = $this->pontuar(
                $comentario->comentario . ' ' .
                $comentario->liceu . ' ' .
                $comentario->turma,
                $termos
            );

            if ($pontuacao === 0) {
                continue;
            }

            $resultados[] = [
                'titulo' => 'Comentário de ' . ($comentario->nome ?: 'visitante'),
                'url' => route('comentarios'),
                'pontuacao' => $pontuacao,
            ];
        }

        return $resultados;
    }

    private function pesquisarSliders(array $termos): array
    {
        $resultados = [];

        foreach (Slider::all() as $slider) {

            $pontuacao = $this->pontuar(
                $slider->titulo_um . ' ' . $slider->titulo_dois,
                $termos
            );

            if ($pontuacao === 0) {
                continue;
            }

            $resultados[] = [
                'titulo' => $slider->titulo_um ?: 'Destaque da Rede Eiffel',
                'url' => url('/'),
                'pontuacao' => $pontuacao,
            ];
        }

        return $resultados;
    }

    private function extrairTermos(string $texto): array
    {
        $ignorar = [
            'quais', 'qual', 'onde', 'como', 'existe', 'existem',
            'mostrar', 'mostra', 'quero', 'ver', 'sobre',
            'rede', 'eiffel', 'site', 'para', 'com',
            'documento', 'documentos', 'pdf', 'comunicado',
            'comunicados', 'foto', 'fotos', 'fotografia',
            'fotografias', 'imagem', 'imagens', 'galeria',
            'galerias', 'comentario', 'comentarios',
            'slider', 'sliders', 'banner', 'banners',
            'the', 'and', 'what', 'where', 'show',
            'les', 'des', 'sur', 'dans'
        ];

        $palavras = preg_split(
            '/[^a-z0-9]+/',
            $texto,
            -1,
            PREG_SPLIT_NO_EMPTY
        );

        return array_values(array_unique(array_filter(
            $palavras,
            fn ($palavra) =>
                strlen($palavra) >= 3 &&
                !in_array($palavra, $ignorar, true)
        )));
    }

    private function pontuar(string $conteudo, array $termos): int
    {
        if (empty($termos)) {
            return 1;
        }

        $conteudo = $this->normalizar($conteudo);
        $pontuacao = 0;

        foreach ($termos as $termo) {
            if ($this->contemPalavra($conteudo, $termo)) {
                $pontuacao++;
            }
        }

        return $pontuacao;
    }

    private function contemPalavra(string $texto, string $termo): bool
    {
        return preg_match(
            '/(?<![a-z0-9])' . preg_quote($termo, '/') . '(?![a-z0-9])/',
            $texto
        ) === 1;
    }

    private function normalizar(string $texto): string
    {
        return trim(
            preg_replace('/\s+/u', ' ', Str::ascii(mb_strtolower($texto)))
        );
    }
}