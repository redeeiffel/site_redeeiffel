<?php

namespace App\Services;

class PesquisaInstitucionalService
{
    public function pesquisar(string $pergunta, string $idioma = 'pt'): ?array
    {
        $texto = app(InterpretadorPerguntasService::class)
            ->corrigir($pergunta);

        if ($texto === '') {
            return null;
        }

        $categoria = $this->identificarCategoria($texto);

        if ($categoria === null) {
            return null;
        }

        $dados = config("assistente_institucional.{$categoria}");

        if (
            !is_array($dados) ||
            !isset($dados['respostas']['pt'], $dados['rota'])
        ) {
            return null;
        }

        $rota = $dados['rota'];

        if (!is_string($rota) || !\Illuminate\Support\Facades\Route::has($rota)) {
            return null;
        }

        $titulos = [
            'apresentacao' => 'Sobre a Rede Eiffel',
            'missao' => 'Missão educativa',
            'objectivos' => 'Objectivos da Rede Eiffel',
            'visao' => 'Perspectivas da Rede Eiffel',
            'valores' => 'Valores da Rede Eiffel',
            'historia' => 'História da Rede Eiffel',
        ];

        return [
            'encontrado' => true,
            'resposta' => $dados['respostas'][$idioma]
                ?? $dados['respostas']['pt'],
            'fontes' => [
                [
                    'titulo' => $titulos[$categoria] ?? 'Rede Eiffel',
                    'url' => route($rota),
                ],
            ],
        ];
    }

    private function identificarCategoria(string $texto): ?string
    {
        $categorias = [
            'missao' => [
                'qual e a missao', 'qual a missao',
                'missao da rede eiffel', 'missao educativa',
                'what is the mission', 'mission of rede eiffel',
                'quelle est la mission', 'mission du reseau eiffel',
            ],

            'visao' => [
                'qual e a visao', 'qual a visao',
                'visao da rede eiffel', 'perspectivas da rede',
                'perspectivas da rede eiffel',
                'what is the vision', 'vision of rede eiffel',
                'quelle est la vision', 'vision du reseau eiffel',
                'perspectives du reseau eiffel',
            ],

            'objectivos' => [
                'qual e o objectivo', 'qual o objectivo',
                'quais sao os objectivos', 'objectivos da rede',
                'qual e o objetivo', 'qual o objetivo',
                'quais sao os objetivos', 'objetivos da rede',
                'what is the objective', 'what are the objectives',
                'what is the goal', 'what are the goals',
                'quel est l objectif', 'quels sont les objectifs',
                'objectifs du reseau eiffel',
            ],

            'valores' => [
                'quais sao os valores', 'valores da rede',
                'valores da rede eiffel', 'valores institucionais',
                'what are the values', 'values of rede eiffel',
                'quelles sont les valeurs',
                'valeurs du reseau eiffel',
            ],

            'historia' => [
                'historia da rede', 'historia da rede eiffel',
                'como surgiu a rede', 'quando surgiu a rede',
                'quando foi criada a rede',
                'quem criou a rede', 'quem fundou a rede',
                'origem da rede eiffel',
                'history of rede eiffel',
                'when was rede eiffel founded',
                'who founded rede eiffel',
                'how did rede eiffel begin',
                'histoire du reseau eiffel',
                'quand le reseau eiffel a ete cree',
                'qui a fonde le reseau eiffel',
            ],

            'apresentacao' => [
                'o que e a rede eiffel',
                'o que e rede eiffel',
                'quem e a rede eiffel',
                'fala me da rede eiffel',
                'fale sobre a rede eiffel',
                'apresentacao da rede eiffel',
                'what is rede eiffel',
                'tell me about rede eiffel',
                'what does rede eiffel do',
                'qu est ce que le reseau eiffel',
                'presentez le reseau eiffel',
                'parlez moi du reseau eiffel',
            ],
        ];

        foreach ($categorias as $categoria => $expressoes) {
            foreach ($expressoes as $expressao) {
                if ($this->contemExpressao($texto, $expressao)) {
                    return $categoria;
                }
            }
        }

        return null;
    }

    private function contemExpressao(
        string $texto,
        string $expressao
    ): bool {
        return preg_match(
            '/(?<![a-z0-9])' .
            preg_quote($expressao, '/') .
            '(?![a-z0-9])/',
            $texto
        ) === 1;
    }
}